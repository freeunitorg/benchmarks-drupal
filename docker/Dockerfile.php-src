# One PHP built from source, per libc, for the isolation question the whole-stack images
# cannot answer: Alpine's php85 package and Debian's PHP 8.5.11 are both 8.5.11 but compiled
# differently, and job 229 showed a 34 percent gap on a Drupal front page that the isolated
# libc pair (7 percent) does not explain.
#
#   docker build -f docker/Dockerfile.php-src --build-arg BASE=debian:trixie-slim -t drupal-bench-freeunit:srcphp-debian .
#   docker build -f docker/Dockerfile.php-src --build-arg BASE=alpine:3.24     -t drupal-bench-freeunit:srcphp-alpine .
#
# The PHP is configured --disable-all plus the modules Unit's PHP module needs and the
# hello workload uses; the same tarball, the same flags, the same -O2 on both libcs, so the
# only remaining variable is the C library.
ARG BASE=debian:trixie-slim

FROM ${BASE} AS build

ARG FREEUNIT_REF=e63168bd3e4d708ce39c1ab7988ec13060dfb325
ARG PHP_VERSION=8.5.11

RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache build-base curl ca-certificates pkgconf re2c \
            openssl-dev pcre2-dev zlib-dev libxml2-dev sqlite-dev oniguruma-dev; \
    else \
        apt-get update; \
        apt-get install -y --no-install-recommends build-essential curl ca-certificates \
            pkg-config re2c libssl-dev libpcre2-dev zlib1g-dev libxml2-dev libsqlite3-dev libonig-dev; \
        rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /usr/src

RUN set -eux; \
    curl -fsSL "https://www.php.net/distributions/php-${PHP_VERSION}.tar.gz" -o php.tar.gz; \
    mkdir php && tar -xzf php.tar.gz -C php --strip-components=1

WORKDIR /usr/src/php

# --disable-all keeps the comparison honest: no distribution patch set, no bundled
# extension built differently on one side. opcache, json, ctype, session and tokenizer are
# what Unit's PHP module and a plain script need.
RUN set -eux; \
    ./configure --prefix=/usr --disable-all --enable-embed --enable-opcache --enable-json \
        --enable-ctype --enable-session --enable-tokenizer --enable-filter \
        --with-openssl --with-zlib; \
    make -j"$(nproc)"; \
    make install

RUN set -eux; \
    curl -fsSL "https://github.com/freeunitorg/freeunit/archive/${FREEUNIT_REF}.tar.gz" -o /tmp/freeunit.tar.gz; \
    mkdir -p /usr/src/freeunit; \
    tar -xzf /tmp/freeunit.tar.gz -C /usr/src/freeunit --strip-components=1

WORKDIR /usr/src/freeunit

RUN set -eux; \
    ./configure --prefix=/usr --statedir=/var/lib/unit \
        --control=unix:/var/run/control.unit.sock \
        --runstatedir=/var/run --pid=/var/run/unit.pid \
        --logdir=/var/log --log=/var/log/unit.log --tmpdir=/var/tmp \
        --user=www-data --group=www-data --modulesdir=/usr/lib/unit/modules \
        --openssl --zlib; \
    ./configure php --config=php-config; \
    make -j"$(nproc)"; \
    make install

FROM ${BASE}

ARG FREEUNIT_REF=e63168bd3e4d708ce39c1ab7988ec13060dfb325
LABEL org.freeunit.ref=$FREEUNIT_REF

RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache openssl pcre2 zlib libxml2 sqlite-libs oniguruma libgcc libstdc++ curl ca-certificates; \
    else \
        apt-get update; \
        apt-get install -y --no-install-recommends libssl3t64 libpcre2-8-0 zlib1g libxml2 \
            libsqlite3-0 libonig5 curl ca-certificates; \
        rm -rf /var/lib/apt/lists/*; \
    fi

# unitd is configured --user=www-data, which Debian has and Alpine does not: without this
# the module loads and every request fails with getpwnam("www-data") failed.
RUN if command -v apk >/dev/null 2>&1; then \
        addgroup -S www-data 2>/dev/null || true; \
        adduser -S -D -H -G www-data -s /sbin/nologin www-data 2>/dev/null || true; \
    fi

COPY --from=build /usr/bin/php /usr/bin/php
COPY --from=build /usr/sbin/unitd /usr/sbin/unitd
COPY --from=build /usr/lib/unit/modules /usr/lib/unit/modules
# The Unit PHP module dlopens the embed SAPI library, so libphp.so has to be in the
# runtime image; without it every request fails with "libphp.so: cannot open shared object".
COPY --from=build /usr/lib/libphp.so /usr/lib/libphp.so
COPY --from=build /usr/lib/php /usr/lib/php
COPY docker/entrypoint-freeunit.sh /usr/local/bin/entrypoint-freeunit.sh
COPY docker/runtimes/freeunit.json /docker-entrypoint.d/config.json
RUN chmod +x /usr/local/bin/entrypoint-freeunit.sh \
    && mkdir -p /var/lib/unit /var/log \
    && ln -sf /dev/stderr /var/log/unit.log

WORKDIR /app
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/entrypoint-freeunit.sh", "unitd", "--no-daemon"]
