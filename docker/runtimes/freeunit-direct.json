{
    "_comment": "A/B variant for plan section 5.4 'the share probe costs a measurable share': dynamic prefixes go straight to the application, everything else still goes through share + fallback. Run the same URLs against freeunit.json to measure the probe.",
    "listeners": {
        "*:80": {
            "pass": "routes"
        }
    },
    "routes": [
        {
            "match": {
                "uri": [
                    "/cron/*",
                    "/user/*",
                    "/node/*",
                    "/admin/*",
                    "/index.php",
                    "/index.php/*"
                ]
            },
            "action": {
                "pass": "applications/drupal/direct"
            }
        },
        {
            "match": {
                "uri": [
                    "*.php",
                    "*.php/*"
                ]
            },
            "action": {
                "pass": "applications/drupal/direct"
            }
        },
        {
            "action": {
                "share": "/app/web$uri",
                "fallback": {
                    "pass": "applications/drupal/index"
                }
            }
        }
    ],
    "applications": {
        "drupal": {
            "type": "php",
            "processes": 20,
            "targets": {
                "direct": {
                    "root": "/app/web/"
                },
                "index": {
                    "root": "/app/web/",
                    "script": "index.php"
                }
            },
            "limits": {
                "requests": 10000,
                "timeout": 30
            },
            "options": {
                "admin": {
                    "opcache.enable": "1",
                    "opcache.validate_timestamps": "0"
                }
            }
        }
    },
    "settings": {
        "http": {
            "max_body_size": 8388608,
            "header_read_timeout": 30,
            "body_read_timeout": 30,
            "send_timeout": 30,
            "idle_timeout": 60
        }
    }
}
