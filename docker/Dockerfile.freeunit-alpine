# FreeUnit on Alpine/musl, for the libc comparison in the benchmark suite.
#
# Alpine's php85 package is the same upstream version as the glibc images (8.5.11) and
# provides the embed SAPI (/usr/lib/php85/libphp.so, php85-embed) and opcache (built
# into php85), so both sides run the same PHP version with opcache enabled.  The
# comparison this image enables is therefore "the whole stack on glibc against the
# whole stack on musl" — which is the operator's real choice — and not pure libc
# isolation, because the two PHP builds differ in their compile options.  For the
# isolation question the harness has tools/libc-cost, which builds one PHP per libc.
#
# -Wl,-E is explicit: without it the container's unitd exported no dynamic symbols at
# all (the native Alpine build of the same source does export 617), so the PHP module
# failed to relocate nxt_conf_*/nxt_lvlhsh_* and every request answered nothing.
#
#   docker build -f docker/Dockerfile.freeunit-alpine -t drupal-bench-freeunit:musl .
ARG FREEUNIT_REF=1.37.0
ARG FREEUNIT_SHA256=8ae237d5a32d77bb8a7426d844ce75aeb18583a4e47318f55e17839d865fad8c

FROM alpine:3.24 AS freeunit-build
ARG FREEUNIT_REF
ARG FREEUNIT_SHA256
RUN set -eux; \
    apk add --no-cache build-base curl ca-certificates \
        openssl-dev pcre2-dev zlib-dev zstd-dev brotli-dev \
        php85-dev php85-embed php85-openssl php85-phar php85-xml php85-tokenizer
RUN set -eux; \
    if [ "$FREEUNIT_REF" = "1.37.0" ]; then \
        curl -fsSL "https://github.com/freeunitorg/freeunit/archive/refs/tags/${FREEUNIT_REF}.tar.gz" -o /tmp/freeunit.tar.gz; \
        echo "${FREEUNIT_SHA256}  /tmp/freeunit.tar.gz" | sha256sum -c -; \
    else \
        curl -fsSL "https://github.com/freeunitorg/freeunit/archive/${FREEUNIT_REF}.tar.gz" -o /tmp/freeunit.tar.gz; \
    fi; \
    mkdir -p /usr/src/freeunit; \
    tar -xzf /tmp/freeunit.tar.gz -C /usr/src/freeunit --strip-components=1; \
    cd /usr/src/freeunit; \
    ./configure --prefix=/usr --statedir=/var/lib/unit --control=unix:/var/run/control.unit.sock \
        --runstatedir=/var/run --pid=/var/run/unit.pid --logdir=/var/log --log=/var/log/unit.log \
        --tmpdir=/var/tmp --user=nobody --group=nobody --modulesdir=/usr/lib/unit/modules \
        --openssl --zlib --zstd --brotli \
        --ld-opt="-Wl,-E"; \

    ./configure php --config=php-config85 --lib-path=/usr/lib/php85; \
    make -j"$(nproc)"; \
    make install

FROM alpine:3.24 AS freeunit
ARG FREEUNIT_REF=1.37.0
LABEL org.freeunit.ref=$FREEUNIT_REF
COPY --from=freeunit-build /usr/sbin/unitd /usr/sbin/unitd
COPY --from=freeunit-build /usr/lib/unit/modules /usr/lib/unit/modules
RUN set -eux; \
    apk add --no-cache php85 php85-embed php85-openssl php85-phar php85-xml php85-tokenizer \
        php85-ctype php85-dom php85-fileinfo php85-simplexml php85-session php85-curl \
        php85-pdo php85-pdo_mysql php85-pdo_pgsql php85-pdo_sqlite php85-mysqli \
        php85-gd php85-intl php85-exif php85-zip php85-mbstring php85-pecl-apcu \
        curl ca-certificates mariadb-client; \
    mkdir -p /var/lib/unit /docker-entrypoint.d /etc/php85/conf.d; \
    ln -sf /dev/stderr /var/log/unit.log
COPY docker/php-production.ini /etc/php85/conf.d/zz-production.ini
COPY docker/runtimes/freeunit.json /docker-entrypoint.d/config.json
COPY docker/entrypoint-freeunit.sh /usr/local/bin/entrypoint-freeunit.sh
RUN chmod +x /usr/local/bin/entrypoint-freeunit.sh
WORKDIR /app
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/entrypoint-freeunit.sh"]
CMD ["unitd", "--no-daemon", "--control", "unix:/var/run/control.unit.sock"]
