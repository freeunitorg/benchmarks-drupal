# Database backends alongside MariaDB: the experimental core mysqli driver,
# PostgreSQL and SQLite, each with its own installed site. The runtime pair stays
# FreeUnit vs nginx+PHP-FPM, so the backend is the variable.
site:11.4:mysqli
site:11.4:pgsql
site:11.4:sqlite
job:bench/jobs/37-auth-freeunit-vs-fpm-11.4-mysqli.job
job:bench/jobs/35-auth-freeunit-vs-fpm-11.4-pgsql.job
job:bench/jobs/36-auth-freeunit-vs-fpm-11.4-sqlite.job
job:bench/jobs/38-front-anon-pgsql-freeunit-vs-fpm-11.4.job
# Pedantic mysqli pass: within-job A/B, same runtime, same null phase. Needs the
# 11.4-mysqli site next to the 11.4 (mysql) one.
site:11.4:mysqli
job:bench/jobs/39-auth-mysqli-vs-mysql-freeunit.job
job:bench/jobs/40-front-mysqli-vs-mysql-freeunit.job
job:bench/jobs/41-auth-mysqli-vs-mysql-fpm.job
