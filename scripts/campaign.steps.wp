# WordPress: front render on FreeUnit (release and master) against the classic
# stacks, the cron request path, and the persistent-connection drop-in against
# stock wpdb on two runtimes.  The smoke job runs first and is deleted after it
# passes; the two sites are built by the steps above the jobs so a rebuilt site
# cannot be measured by accident.
site:wp
site:wp-persistent
job:bench/jobs/75-wp-smoke.job
job:bench/jobs/42-wp-front-freeunit-vs-nginx-fpm.job
job:bench/jobs/43-wp-front-freeunit-master-vs-nginx-fpm.job
job:bench/jobs/44-wp-front-nginx-fpm-vs-apache.job
job:bench/jobs/45-wp-cron-freeunit-vs-nginx-fpm.job
job:bench/jobs/46-wp-persistent-vs-default-freeunit.job
job:bench/jobs/47-wp-persistent-vs-default-nginx-fpm.job
