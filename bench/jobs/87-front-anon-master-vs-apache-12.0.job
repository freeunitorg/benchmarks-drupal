# The same cell as 77 with the master image on Drupal 12.
JOB=87-front-anon-master-vs-apache-12.0
ISSUE="https://github.com/freeunitorg/benchmarks-drupal"
PHASES="null ab"
WORKLOAD=drupal-front
RUNTIME_A=freeunit-master
RUNTIME_B=apache
SITE=12.0
DB=mysql
CONNS=32
WARM=2
DUR=8
REPS=3
PERF=1
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT="mod_php costs more per request than the alternative"
FALSIFY="a delta inside the null band, or Apache cheaper"
