# The 1.37.1 release tarball against nginx + PHP-FPM: the headline cell redone on the release, so the page compares releases only.
JOB=268-wp-front-1371-vs-fpm
ISSUE="https://github.com/freeunitorg/benchmarks-drupal"
PHASES="null ab"
WORKLOAD=wp-front
RUNTIME_A=freeunit-1371
RUNTIME_B=nginx-fpm
SITE=wp
DB=mysql
CONNS=32
WARM=2
DUR=10
REPS=4
PERF=1
DECOMPOSE=0
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT="level, as 42 found for 1.37.0"
FALSIFY="a CLAIM larger than 2 percent either way"
