# PR #742 (finish the mixed atomic and plain accesses) against its base ff694772, on
# the aarch64 host.  No PMU here, so the primary metric is server CPU per request and
# the CPU sets follow the ARM convention: server on core 0, load and database on 1.
JOB=117-742-front-anon-atomic-arm
ISSUE="https://github.com/freeunitorg/freeunit/issues/742"
PHASES="null ab"
WORKLOAD=drupal-front
RUNTIME_A=freeunit-742-base
RUNTIME_B=freeunit-742-head
SITE=12.0
DB=mysql
CONNS=32
WARM=2
DUR=6
REPS=2
PERF=0
SERVER_CPUS=0
LOAD_CPUS=1
DB_CPUS=1
PRIMARY=server_us
NULL_LIMIT_PCT=5
EXPECT="finishing the atomic/plain sweep does not cost measurable server CPU per request on aarch64"
FALSIFY="a delta inside the null band, or the head measurably slower: then the fix has a price worth recording"
