# WordPress 7.1.3 on wp-front: FreeUnit vs the classic stack.
# WordPress has no page cache and uses mysqli directly (there is no PDO path), so
# every measured request is a full bootstrap plus its queries.
JOB=43-wp-front-freeunit-master-vs-nginx-fpm
ISSUE=https://github.com/freeunitorg/benchmarks-drupal
PHASES="null ab"
WORKLOAD=wp-front
RUNTIME_A=freeunit-master
RUNTIME_B=nginx-fpm
SITE=wp
DB=mysql
CONNS=32
WARM=2
DUR=8
REPS=3
PERF=1
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT="FreeUnit at or below the classic stack on a full WordPress render"
FALSIFY="NO CLAIM, or the classic stack cheaper"
