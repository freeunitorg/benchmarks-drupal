# The small-body point of the Python body sweep: the same app, 1 KiB of body, Unit-with-python-module against nginx+gunicorn. The PHP leg's gap grows with body size; this asks whether the Python leg's does.
JOB=202-py-body-1k
ISSUE="https://github.com/freeunitorg/freeunit-exp/issues/113"
PHASES="null ab"
WORKLOAD=py-body-1k
RUNTIME_A=freeunit-python
RUNTIME_B=gunicorn
SITE=py-hello
DB=mysql
CONNS=32
WARM=2
DUR=6
REPS=2
PERF=0
SERVER_CPUS=0
LOAD_CPUS=1
DB_CPUS=1
PRIMARY=server_us
NULL_LIMIT_PCT=5
EXPECT="unit's python module and gunicorn differ by a per-request constant, not per byte"
FALSIFY="a trend that is not monotone with the swept dimension, or a CLAIM with the wrong sign"
