# The same pair on php-fpm, where the worker also survives between requests. Two
# runtimes are measured so a result can be attributed to the drop-in and not to one
# server's connection handling.
JOB=47-wp-persistent-vs-default-nginx-fpm
ISSUE="https://github.com/freeunitorg/benchmarks-drupal"
PHASES="null ab"
WORKLOAD=wp-front
RUNTIME_A=nginx-fpm
RUNTIME_B=nginx-fpm
SITE=wp
SITE_B=wp-persistent
DB=mysql
CONNS=32
WARM=2
DUR=10
REPS=4
PERF=1
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT="the persistent handle removes a measurable share on php-fpm as well"
FALSIFY="NO CLAIM: the connection setup is not a measurable share at this cell"
