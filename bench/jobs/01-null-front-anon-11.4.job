# Null band for the front-anon cell on FreeUnit 1.37.0, Drupal 11.4.8.
# Run this first on the same day as the ab jobs: the published page prints the
# null band under every chart (plan section 5.1). Longer cells (8 s) because the
# powersave governor gives wide bands at 2 s (perf-lab.md:140-152).
JOB=01-null-front-anon-11.4
ISSUE=https://github.com/freeunitorg/benchmarks-drupal
PHASES=null
WORKLOAD=drupal-front
RUNTIME_A=freeunit
RUNTIME_B=freeunit
SITE=11.4
CONNS=32
WARM=2
DUR=8
REPS=4
PERF=1
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT=null band under 5 percent on s_instructions; rps and latency bands recorded as they come
FALSIFY=a null band over 5 percent on s_instructions: the box is too noisy for an instructions claim at this cell
