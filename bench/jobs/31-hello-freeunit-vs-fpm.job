# Control: no Drupal, no database -- the same PHP file served by both runtimes.
# Isolates the server (front proxy + PHP worker plumbing) from the application.
JOB=31-hello-freeunit-vs-fpm
ISSUE=https://github.com/freeunitorg/benchmarks-drupal
PHASES="null ab"
WORKLOAD=php-hello
RUNTIME_A=freeunit
RUNTIME_B=nginx-fpm
SITE=hello
CONNS=32
WARM=2
DUR=8
REPS=3
PERF=1
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT="FreeUnit at or below nginx+FPM on a request with no framework work"
FALSIFY="FPM below FreeUnit by more than the null band"
