# The compute axis at the same 20k point the PHP work sweep used.
JOB=206-py-work-20k
ISSUE="https://github.com/freeunitorg/freeunit-exp/issues/113"
PHASES="null ab"
WORKLOAD=py-work-20k
RUNTIME_A=freeunit-python
RUNTIME_B=gunicorn
SITE=py-hello
DB=mysql
CONNS=32
WARM=2
DUR=6
REPS=2
PERF=0
SERVER_CPUS=0
LOAD_CPUS=1
DB_CPUS=1
PRIMARY=server_us
NULL_LIMIT_PCT=5
EXPECT="the delta is flat with work size"
FALSIFY="a trend that is not monotone with the swept dimension, or a CLAIM with the wrong sign"
