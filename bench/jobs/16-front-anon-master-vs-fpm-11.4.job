# drupal-front, FreeUnit master (A) vs nginx-fpm (B), Drupal 11.4.
# The master image is pinned to the commit in run/freeunit-master-sha and records
# it at /etc/freeunit-ref; meta.txt carries the same SHA.
JOB=16-front-anon-master-vs-fpm-11.4
ISSUE=https://github.com/freeunitorg/benchmarks-drupal
PHASES="null ab"
WORKLOAD=drupal-front
RUNTIME_A=freeunit-master
RUNTIME_B=nginx-fpm
SITE=11.4
CONNS=32
WARM=2
DUR=8
REPS=3
PERF=1
SERVER_CPUS=0,1
LOAD_CPUS=2,3,6,7
DB_CPUS=4,5
PRIMARY=s_instructions
NULL_LIMIT_PCT=5
EXPECT="master keeps the FreeUnit advantage measured on 1.37.0"
FALSIFY="NO CLAIM, or master loses to nginx-fpm"
